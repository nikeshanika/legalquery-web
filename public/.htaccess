# Apache: send every request that is not a real file to index.php.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # No bot gets a PDF (owner, 2026-11-25): Google, Bing and other crawlers, scripts (curl, wget, python …)
  # and requests without a User-Agent get 403 on the PDF download page (/pdf?…), old PDF URLs
  # (/files/…, /acts/….pdf) and any .pdf. Besides robots.txt (Disallow /pdf, /files/), noindex and the
  # sum question on the download page (PdfGate).
  RewriteCond %{HTTP_USER_AGENT} (bot|crawl|spider|slurp|archiver|facebookexternalhit|curl|wget|python|scrapy|httpclient|libwww|java/|go-http|okhttp|axios|node-fetch|headless|phantomjs|puppeteer|playwright|selenium) [NC,OR]
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule (^pdf$|^files/|\.pdf$) - [F,L]

  # A real .pdf file under public/ (there should be none) is never served as it is.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.pdf$ - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Compressed responses load faster (page speed is a ranking signal).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # CSS and JS are linked with ?v=N and the version is raised on every change.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
